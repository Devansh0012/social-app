# Database
DATABASE_URL="postgresql://braventex:braventex@localhost:5432/braventex?schema=public"
# Used only by Prisma migrations. In prod (Neon, PgBouncer-fronted), set this to
# the *non-pooled* URL. In dev you can leave it equal to DATABASE_URL.
DIRECT_DATABASE_URL="postgresql://braventex:braventex@localhost:5432/braventex?schema=public"

# API
API_HOST="0.0.0.0"
API_PORT="4000"
API_PUBLIC_URL="http://localhost:4000"
NODE_ENV="development"
LOG_LEVEL="info"
CORS_ORIGIN="http://localhost:3000"

# Auth
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL_SECONDS="900"            # 15 min
JWT_REFRESH_TTL_SECONDS="2592000"        # 30 days
EMAIL_VERIFY_TTL_SECONDS="86400"         # 24h
PASSWORD_RESET_TTL_SECONDS="3600"        # 1h

# Storage (driver: local | s3 | r2)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./uploads"
STORAGE_PUBLIC_PREFIX="/uploads"
# S3 / R2 (only used if STORAGE_DRIVER=s3 or r2)
STORAGE_S3_BUCKET=""
STORAGE_S3_REGION="auto"                           # R2 → "auto", AWS → eg "us-east-1"
STORAGE_S3_ENDPOINT=""                              # R2 → "https://<account>.r2.cloudflarestorage.com"
STORAGE_S3_ACCESS_KEY_ID=""
STORAGE_S3_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_BASE_URL=""                          # R2 → pub-...r2.dev or cdn.braventex.in; empty=presign

# Rate limit
RATE_LIMIT_MAX="200"
RATE_LIMIT_WINDOW="1 minute"

# Email (Resend) — leave RESEND_API_KEY blank in dev to log verify links to the console.
RESEND_API_KEY=""
EMAIL_FROM="Braventex <noreply@braventex.in>"
EMAIL_REPLY_TO=""
APP_PUBLIC_URL="http://localhost:3000"   # web URL used inside email CTAs

# Web
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_GRAPHQL_URL="http://localhost:4000/graphql"
NEXT_PUBLIC_WS_URL="ws://localhost:4000/ws"
